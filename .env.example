# Copie este arquivo para .env e preencha. O .env NÃO vai para o Git.

# Conexão do MongoDB Atlas. Deixe em branco para usar o MongoDB em memória.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=thindesk

# Senhas dos usuários de demonstração (criados na primeira execução)
SENHA_ADMIN=troque-esta-senha
SENHA_TECNICO=tecnico123
SENHA_USUARIO=usuario123

# Cria clientes, horários e chamados de exemplo quando o banco está vazio
DADOS_EXEMPLO=true
# Mostra as credenciais de técnico e usuário na tela de login
MOSTRAR_CREDENCIAIS=true
